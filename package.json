{
  "name": "personal-nav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port ${PORT:-8788}",
    "build": "next build --webpack",
    "build:sites": "node scripts/build-sites.mjs",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-8788}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
